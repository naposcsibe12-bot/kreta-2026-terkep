{
  "name": "kreta-2026-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "Kréta 2026 offline térképes iOS alkalmazás",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build:web": "vite build",
    "check:offline": "node scripts/check-offline.mjs",
    "check": "npm run typecheck && npm run check:offline && npm run build:web",
    "sync": "npm run build:web && npx cap sync ios",
    "open:ios": "npx cap open ios"
  },
  "dependencies": {
    "@capacitor/core": "^7.4.3",
    "@capacitor/geolocation": "^7.1.2",
    "@capacitor/network": "^7.0.2",
    "maplibre-gl": "^5.6.0",
    "pmtiles": "^4.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3",
    "typescript": "^5.8.3",
    "vite": "^7.1.5"
  }
}
